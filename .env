# ==========================================
# AURA Voice Chatbot — Environment Configuration
# ==========================================

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Speech-to-Text (STT) Options: deepgram, groq_whisper, browser, mock
STT_PROVIDER=mock
DEEPGRAM_API_KEY=

# LLM Intelligence Options: groq, gemini, openai, mock
LLM_PROVIDER=mock
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Text-to-Speech (TTS) Options: edge_tts (Free, zero config!), elevenlabs, cartesia, mock
TTS_PROVIDER=edge_tts
EDGE_TTS_VOICE=en-US-JennyNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091

# Audio & Voice Activity Detection Settings
SAMPLE_RATE=16000
VAD_SILENCE_THRESHOLD_MS=350
VAD_ENERGY_THRESHOLD=0.015
